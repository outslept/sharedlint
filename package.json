{
  "name": "root",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "pnpm run format:prettier && pnpm run format:eslint",
    "format:prettier": "prettier --write \"**/*.{js,ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.11.0",
    "@types/node": "^22.14.1",
    "eslint": "^9.23.0",
    "eslint-plugin-format": "^1.0.1",
    "nano-staged": "^0.8.0",
    "simple-git-hooks": "^2.12.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "ansis": "^3.17.0",
    "hono": "^4.7.7",
    "mri": "^1.2.0",
    "ofetch": "^1.4.1",
    "ora": "^8.2.0",
    "pathe": "^2.0.3"
  }
}
